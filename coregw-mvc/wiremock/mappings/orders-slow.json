{
  "name": "orders-slow",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/orders",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.mockScenario",
          "equalTo": "slow"
        }
      }
    ]
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json"
    },
    "fixedDelayMilliseconds": 5000,
    "jsonBody": {
      "orderId": "{{randomValue type='UUID'}}",
      "status": "CREATED"
    }
  }
}
